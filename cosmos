#!/usr/bin/env bash
set -euo pipefail
cosmos_script=$(readlink -f -- "${BASH_SOURCE[0]}")
cosmos_root=$(cd -- "$(dirname -- "$cosmos_script")" && pwd)
if [[ -x "$cosmos_root/bin/cosmos" ]]; then
    export COSMOS_BINARY="${COSMOS_BINARY:-$cosmos_root/bin/cosmos}"
fi
if [[ -d "$cosmos_root/lib" ]]; then
    export LD_LIBRARY_PATH="$cosmos_root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export PYTHONPATH="$cosmos_root/python:$cosmos_root/terminal_agent${PYTHONPATH:+:$PYTHONPATH}"
exec "$cosmos_root/.venv/bin/python" -m cosmos_tui "$@"
