+export function cosmosPermissionCategory(action: string, metadata: Dict = {}) {
+  if (["read", "list", "grep", "glob", "cosmos_directory_read"].includes(canonicalToolName(action)))
+    return "Read directory"
+  if (metadata.interrupt === true || /close|kill|interrupt|privacy/.test(action))
+    return "Destructive / interrupt (separate confirmation)"
+  if (
+    /acquire_workspace|release_workspace|create_terminal|create_session|rename_target|focus_pane|open_file|invoke_action/.test(
+      action,
+    )
+  )
+    return "Workspace management"
+  if (
+    /acquire_control|release_control|control_input|terminal_step|request_resume|schedule_task|finish_task/.test(action)
+  )
+    return "Terminal task"
+  return "Host writes / execution"
+}
+
+export function permissionPresentation(
+  source: PermissionPresentationInput,
+  formatPath: (value: string) => string = (value) => value,
+): PermissionPresentation {
+  const base = basePermissionPresentation(source, formatPath)
+  const metadata = { ...dict(source.toolMetadata), ...dict(source.metadata) }
+  const input = normalizeInput(canonicalToolName(source.action), source.input)
+  if (metadata.cosmos_scope === undefined && !metadata.capability && !metadata.cosmos_resume) return base
+  const category = cosmosPermissionCategory(source.action, metadata)
+  const read = category === "Read directory"
+  const scope =
+    text(metadata.pane) ||
+    text(metadata.cosmos_scope) ||
+    source.resources.filter((r) => typeof r === "string").join(", ") ||
+    "Current project"
+  const duration = metadata.cosmos_resume
+    ? "One resume confirmation; no terminal input permission"
+    : metadata.capability
+      ? "This conversation + task + terminal; ends on release, finish or pause"
+      : read
+        ? "Once, or remember this directory for the project"
+        : "This request; existing saved/configured rules are managed separately"
+  const writes = read
+    ? "No"
+    : metadata.cosmos_resume
+      ? "No terminal input; resumes task state only"
+      : category === "Terminal task"
+        ? "Yes: terminal input can run commands and modify files"
+        : category === "Workspace management"
+          ? "Workspace state; close/interrupt require separate approval"
+          : "Yes or possible: inspect command, directory and changes"
+  return {
+    ...base,
+    lines: [
+      ...(base.variant === "resume" ? base.lines.slice(0, 2) : base.lines),
+      ...(metadata.task ? [`Task: ${text(metadata.task)}`] : []),
+      `Category: ${category}`,
+      ...(read ? ["Includes: file reads, directory listing and text search; no execution"] : []),
+      `Scope: ${formatPath(scope)}`,
+      `Lifetime: ${duration}`,
+      `Writes: ${writes}`,
+      ...(input.workdir || metadata.workdir ? [`Directory: ${text(input.workdir) || text(metadata.workdir)}`] : []),
+    ],
+  }
+}
